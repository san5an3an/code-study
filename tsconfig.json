{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@spartan-ng/helm/sidebar": ["./libs/ui/sidebar/src/index.ts"],
      "@spartan-ng/helm/utils": ["./libs/ui/utils/src/index.ts"],
      "@spartan-ng/helm/button": ["./libs/ui/button/src/index.ts"],
      "@spartan-ng/helm/input": ["./libs/ui/input/src/index.ts"],
      "@spartan-ng/helm/separator": ["./libs/ui/separator/src/index.ts"],
      "@spartan-ng/helm/sheet": ["./libs/ui/sheet/src/index.ts"],
      "@spartan-ng/helm/skeleton": ["./libs/ui/skeleton/src/index.ts"],
      "@spartan-ng/helm/tooltip": ["./libs/ui/tooltip/src/index.ts"],
      "@spartan-ng/helm/tabs": ["./libs/ui/tabs/src/index.ts"],
      "@spartan-ng/helm/card": ["./libs/ui/card/src/index.ts"],
      "@spartan-ng/helm/badge": ["./libs/ui/badge/src/index.ts"],
      "@spartan-ng/helm/progress": ["./libs/ui/progress/src/index.ts"],
      "@spartan-ng/helm/checkbox": ["./libs/ui/checkbox/src/index.ts"],
      "@spartan-ng/helm/radio-group": ["./libs/ui/radio-group/src/index.ts"],
      "@spartan-ng/helm/scroll-area": ["./libs/ui/scroll-area/src/index.ts"],
      "@spartan-ng/helm/textarea": ["./libs/ui/textarea/src/index.ts"],
      "@spartan-ng/helm/collapsible": ["./libs/ui/collapsible/src/index.ts"],
      "@spartan-ng/helm/alert": ["./libs/ui/alert/src/index.ts"],
      "@spartan-ng/helm/empty": ["./libs/ui/empty/src/index.ts"],
      "@spartan-ng/helm/kbd": ["./libs/ui/kbd/src/index.ts"],
      "@spartan-ng/helm/breadcrumb": ["./libs/ui/breadcrumb/src/index.ts"],
      "@spartan-ng/helm/slider": ["./libs/ui/slider/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
